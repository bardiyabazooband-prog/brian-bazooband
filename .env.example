# Public: set to your canonical website origin for request verification.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CALENDAR_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_AVAILABLE=false

# Supabase project used for Brian's inquiries (safe to use publishable key here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Recommended: distributed rate limiting against automated submissions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional additional allowed origin, e.g. exact Vercel preview origin.
CONTACT_ALLOWED_ORIGIN=

# Previously used email-delivery credentials are no longer required for
# Supabase inquiry storage. You can separately add email alerts later.
